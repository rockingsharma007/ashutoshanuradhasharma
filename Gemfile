source "https://rubygems.org"

# Matches the version GitHub Pages runs, so a local `bundle exec jekyll serve`
# behaves like production. Optional — GitHub builds the site for you on push.
gem "github-pages", group: :jekyll_plugins

gem "webrick", "~> 1.8" # needed to run Jekyll locally on Ruby 3+

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end
